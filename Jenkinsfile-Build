pipeline {

    agent any


    tools {
        maven 'maven'
    }


    environment {

        IMAGE_NAME = "springboot-app"
        DOCKER_REPO = "saikumar004"
        IMAGE_TAG = "latest"

    }


    stages {


        stage('Checkout Code') {

            steps {

                echo "Pulling code from GitHub"

                checkout scm

            }

        }



        stage('Maven Clean') {

            steps {

                sh 'mvn clean'

            }

        }



        stage('Build Application') {

            steps {

                sh 'mvn package -DskipTests'

            }

        }



        stage('Docker Build') {

            steps {

                sh '''
                docker build \
                -t ${IMAGE_NAME}:${IMAGE_TAG} .
                '''

            }

        }



        stage('Docker Login') {

            steps {

                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-cred-id',
                    usernameVariable: 'USERNAME',
                    passwordVariable: 'PASSWORD'
                )]) {


                    sh '''

                    echo "$PASSWORD" | docker login \
                    -u "$USERNAME" \
                    --password-stdin

                    '''

                }

            }

        }




        stage('Docker Tag') {

            steps {

                sh '''

                docker tag \
                ${IMAGE_NAME}:${IMAGE_TAG} \
                ${DOCKER_REPO}/${IMAGE_NAME}:${IMAGE_TAG}

                '''

            }

        }




        stage('Docker Push') {

            steps {

                sh '''

                docker push \
                ${DOCKER_REPO}/${IMAGE_NAME}:${IMAGE_TAG}

                '''

            }

        }



        stage('Docker Logout') {

            steps {

                sh 'docker logout'

            }

        }


    }



    post {


        success {

            echo "Docker Image pushed successfully"

        }


        failure {

            echo "Build Failed"

        }


    }

}